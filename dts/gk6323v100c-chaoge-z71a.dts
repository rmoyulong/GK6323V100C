// SPDX-License-Identifier: GPL-2.0+
/*
 * 国科微 GK6323V100C（整机型号 ChaoGe Z71A）板级设备树 —— 引导最小集
 *
 * 数据来源：真机原厂内核导出的 /sys/firmware/devicetree/base，逐项对齐。
 * 真机实测：4×Cortex-A55（MIDR 0x412FD050）+ ARM GICv3 + 国科私有 CRU。
 *
 * 设备树体积硬约束：
 *   U-Boot bootcmd = mmc read 0 0x03FFC000 0x19000 0x20
 *   即从 dtbo 分区（起始块 0x19000）只读 0x20 = 32 块 = 16 KiB 到 0x03FFC000。
 *   作者那版 dtbo 里的 dtb 是 9156 字节；本文件只保留点亮系统必需节点。
 *
 * 与真机原树的有意差异（让主线内核能认领硬件）：
 *   1) eMMC 的 compatible 追加 "snps,dw-mshc"，使主线 dw_mmc-pltfm 认领；
 *   2) 各外设时钟改指 fixed-clock，不再引用国科私有 CRU（主线无该驱动）；
 *   3) 主线无驱动的节点（aiao、cpufreq、thermal、ir、cru）不写。
 */

/dts-v1/;

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/gpio/gpio.h>

/ {
    model = "ChaoGe Z71A (GK6323V100C)";
    compatible = "goke,gk6323v100c", "hisilicon,hi3798mv200";
    interrupt-parent = <&gic>;
    #address-cells = <2>;
    #size-cells = <2>;

    chosen {
        stdout-path = "serial0:115200n8";
    };

    aliases {
        serial0 = &uart0;
        mmc0 = &emmc;
        ethernet0 = &eth;
    };

    psci {
        compatible = "arm,psci-1.0", "arm,psci-0.2";
        method = "smc";
    };

    cpus {
        #address-cells = <1>;
        #size-cells = <0>;

        cpu-map {
            cluster0 {
                core0 { cpu = <&cpu0>; };
                core1 { cpu = <&cpu1>; };
                core2 { cpu = <&cpu2>; };
                core3 { cpu = <&cpu3>; };
            };
        };

        cpu0: cpu@0 {
            device_type = "cpu";
            compatible = "arm,cortex-a55";
            reg = <0x000>;
            enable-method = "psci";
            next-level-cache = <&l2>;
        };
        cpu1: cpu@1 {
            device_type = "cpu";
            compatible = "arm,cortex-a55";
            reg = <0x001>;
            enable-method = "psci";
            next-level-cache = <&l2>;
        };
        cpu2: cpu@2 {
            device_type = "cpu";
            compatible = "arm,cortex-a55";
            reg = <0x002>;
            enable-method = "psci";
            next-level-cache = <&l2>;
        };
        cpu3: cpu@3 {
            device_type = "cpu";
            compatible = "arm,cortex-a55";
            reg = <0x003>;
            enable-method = "psci";
            next-level-cache = <&l2>;
        };

        l2: l2-cache0 {
            compatible = "cache";
        };
    };

    /* 24MHz 外部晶振，时钟控制器依赖 */
    osc24m: osc24m {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <24000000>;
        clock-output-names = "osc24m";
    };

    timer {
        compatible = "arm,armv8-timer";
        interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
                     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
                     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
                     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>;
        always-on;
    };

    /* 真机 2 GiB DDR */
    memory@0 {
        device_type = "memory";
        reg = <0x0 0x00000000 0x0 0x80000000>;
    };

    reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        /* ATF (BL31) 保留区，真机日志验证 */
        bl31@8020000 {
            reg = <0x0 0x08020000 0x0 0x00200000>;
            no-map;
        };
    };

    gic: interrupt-controller@f1000000 {
        compatible = "arm,gic-v3";
        #interrupt-cells = <3>;
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;
        interrupt-controller;
        reg = <0x0 0xf1000000 0x0 0x10000>,    /* GICD */
              <0x0 0xf1080000 0x0 0x200000>;   /* GICR（REDIST */
        interrupts = <GIC_PPI 9 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)>;
    };

    soc: soc@f0000000 {
        compatible = "simple-bus";
        #address-cells = <2>;
        #size-cells = <2>;
        ranges = <0x0 0x0 0x0 0xf0000000 0x0 0x10000000>;
        dma-ranges;

        uart0: serial@f8b00000 {
            compatible = "arm,pl011", "arm,primecell";
            reg = <0x0 0xf8b00000 0x0 0x1000>;
            interrupts = <GIC_SPI 25 IRQ_TYPE_LEVEL_HIGH>;
            clocks = <&osc24m>, <&osc24m>;
            clock-names = "uartclk", "apb_pclk";
            status = "okay";
        };

        /* eMMC：追加 snps,dw-mshc 使主线 dw_mmc-pltfm 认领 */
        emmc: mmc@f9820000 {
            compatible = "goke,gk6323v100c-mshc", "snps,dw-mshc";
            reg = <0x0 0xf9820000 0x0 0x2000>;
            interrupts = <GIC_SPI 61 IRQ_TYPE_LEVEL_HIGH>;
            clocks = <&osc24m>, <&osc24m>, <&osc24m>;
            clock-names = "ciu", "biu", "ciu-sample";
            fifo-depth = <256>;
            bus-width = <8>;
            non-removable;
            cap-mmc-highspeed;
            cap-mmc-hs200-1_8v;
            max-frequency = <150000000>;
            status = "okay";
        };

        /* 千兆以太网 MAC */
        eth: ethernet@f9c30000 {
            compatible = "hisilicon,hi3798mv200-femac";
            reg = <0x0 0xf9c30000 0x0 0x1000>,
                  <0x0 0xf9c31000 0x0 0x1000>,
                  <0x0 0xf9c32000 0x0 0x1000>;
            reg-names = "mac", "glb", "mii";
            interrupts = <GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>;
            clocks = <&osc24m>, <&osc24m>;
            clock-names = "stmmaceth", "mac-clk";
            phy-mode = "rmii";
            phy-handle = <&phy0>;
            status = "okay";

            mdio {
                #address-cells = <1>;
                #size-cells = <0>;
                phy0: ethernet-phy@2 {
                    reg = <0x2>;
                };
            };
        };

        /* USB 2.0 Host (OHCI+EHCI) */
        usb@f9880000 {
            compatible = "generic-ohci";
            reg = <0x0 0xf9880000 0x0 0x1000>;
            interrupts = <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>;
            clocks = <&osc24m>;
            status = "okay";
        };
        usb@f9890000 {
            compatible = "generic-ehci";
            reg = <0x0 0xf9890000 0x0 0x1000>;
            interrupts = <GIC_SPI 65 IRQ_TYPE_LEVEL_HIGH>;
            clocks = <&osc24m>;
            status = "okay";
        };

        /* RTC */
        rtc@f8a00000 {
            compatible = "hisilicon,hi6220-rtc";
            reg = <0x0 0xf8a00000 0x0 0x1000>;
            interrupts = <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>;
            clocks = <&osc24m>;
            status = "okay";
        };

        /* 看门狗 */
        watchdog@f8003000 {
            compatible = "arm,sp805", "arm,primecell";
            reg = <0x0 0xf8003000 0x0 0x1000>;
            interrupts = <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>;
            clocks = <&osc24m>, <&osc24m>;
            clock-names = "wdogclk", "apb_pclk";
            status = "okay";
        };
    };
};
