// SPDX-License-Identifier: GPL-2.0+
/*
 * 国科微 GK6323V100C（整机型号 ChaoGe Z71A）板级设备树 —— CRG 接入版
 *
 * 基于「引导最小集」加入最小 CRG 驱动的时钟/复位：
 *   - CRU/CRG 节点 compatible 切换为 "goke,gk6323v100c-crg"，
 *     由本补丁新增的最小驱动 crg-gk6323v100c.c 在 arch_initcall_sync 阶段
 *     probe（控制台已建好，出错可见 dmesg，不会花屏锁死）。
 *   - eMMC、FEMAC(+MDIO)、EHCI、OHCI 四个节点接入 CRG 的门控时钟与复位，
 *     时钟 ID / 复位 ID 数字直接写出，避免 dtc 预处理。
 *   - 加回 vdp@7f000000 保留区（U-Boot 帧缓冲在 0x7f511000，被内核当
 *     普通内存覆盖会花屏）。
 *   - 加 USB2 PHY 占位节点（phys 属性先不接，PHY 驱动要单独写，本轮先
 *     让 EHCI/OHCI 的时钟和复位通）。
 *
 * 其他结构（内存 / GIC / PSCI / uart / i2c2 / rtc / watchdog / ranges）
 * 完全保持与可启动版本一致，不做任何重构。
 */

/dts-v1/;

/ {
	model = "ChaoGe Z71A (GK6323V100C) ARM64";
	compatible = "chaoge,z71a", "goke,gk6323v100c";
	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&gic>;

	aliases {
		serial0 = &uart0;
	};

	chosen {
		bootargs = "earlycon=pl011,mmio32,0xf8b00000,115200n8 console=ttyAMA0,115200n8 console=tty0 clk_ignore_unused net.ifnames=0 root=/dev/mmcblk0p18 rootfstype=ext4 rootwait rw panic=-1 blkdevparts=mmcblk0:1M(fastboot),512K(bootargs),512K(bootargsbak),20M(recovery),2M(deviceinfo),8M(securestore),2M(atf),8M(baseparam),8M(pqparam),2M(dtbo),10M(logo),10M(logobak),20M(fastplay),20M(recoverybak),60M(boot),20M(misc),20M(trustedcore),-(rootfs)";
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x80000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		bl31@8020000 {
			reg = <0x00 0x8020000 0x00 0x200000>;
			no-map;
		};

		optee@d200000 {
			reg = <0x00 0xd200000 0x00 0x400000>;
			no-map;
		};

		/*
		 * VDP/framebuffer 保留区（16MB）：
		 * U-Boot 在 0x7f511000 放了开机 logo 的帧缓冲，若内核把
		 * 这块当普通内存分配，会立刻盖掉画面造成花屏/黑屏。
		 * 与原厂设备树 vdp@7f000000 对齐。
		 */
		vdp@7f000000 {
			reg = <0x00 0x7f000000 0x00 0x01000000>;
			no-map;
		};
	};

	/* 固定时钟：给 uart/i2c/看门狗/CRG 父时钟用 */
	clocks {
		clk_24m: clk-24m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <24000000>;
		};

		clk_50m: clk-50m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <50000000>;
		};

		clk_75m: clk-75m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <75000000>;
		};
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0>;
			enable-method = "psci";
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			enable-method = "psci";
		};

		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			enable-method = "psci";
		};

		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			enable-method = "psci";
		};
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <1 13 4>, <1 14 4>, <1 11 4>, <1 10 4>;
		clock-frequency = <24000000>;
	};

	gic: interrupt-controller@f1000000 {
		compatible = "arm,gic-v3";
		reg = <0x0 0xf1000000 0x0 0x10000>,
		      <0x0 0xf1040000 0x0 0x80000>;
		interrupt-controller;
		#interrupt-cells = <3>;
	};

	soc: soc@f0000000 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges = <0xf0000000 0x0 0xf0000000 0x10000000>;

		/*
		 * CRU/CRG 时钟复位控制器（最小驱动版）
		 *
		 * 基址 f8a22000 来源：
		 *   - 原厂 TTL 第 207 行：gk6323v100c-cru f8a22000.clock
		 *   - 原厂反编译 dts：clock@f8a22000
		 *   - Hi3798MV310 BSP: hivendor_clock 基址 f8a22000
		 *
		 * compatible = "goke,gk6323v100c-crg" 由本补丁
		 * crg-gk6323v100c.c 绑定。
		 * 时钟 ID 与复位 ID 全部使用数字，避免 dtc 预处理。
		 * #clock-cells = <1>, #reset-cells = <1>：
		 *   - clocks = <&cru CLK_ID>
		 *   - resets = <&cru RST_ID>
		 */
		cru: clock@f8a22000 {
			compatible = "goke,gk6323v100c-crg", "syscon", "simple-mfd";
			reg = <0xf8a22000 0x400>;
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		/* USB2 PHY 占位：后续单独写 inno-usb2-phy 驱动再启用 phys 引用 */
		usb2_phy: usb-phy@f9865000 {
			compatible = "hisilicon,hi3798mv200-usb2-phy";
			reg = <0xf9865000 0x1000>;
			#phy-cells = <0>;
			status = "disabled";
		};

		/* 控制台串口 */
		uart0: serial@f8b00000 {
			compatible = "arm,pl011", "arm,primecell";
			reg = <0xf8b00000 0x1000>;
			interrupts = <0 49 4>;
			clocks = <&clk_75m>, <&clk_75m>;
			clock-names = "uartclk", "apb_pclk";
		};

		i2c2: i2c@f8b12000 {
			compatible = "hisilicon,hix5hd2-i2c";
			reg = <0xf8b12000 0x1000>;
			interrupts = <0 40 4>;
			clocks = <&clk_50m>;
			clock-names = "apb_pclk";
			clock-frequency = <100000>;
			#address-cells = <1>;
			#size-cells = <0>;

			rtc@51 {
				compatible = "nxp,pcf8563";
				reg = <0x51>;
			};
		};

		/*
		 * eMMC：根文件系统在 mmcblk0p18
		 * clocks: 0=BIU(bus), 1=CIU（即 GK6323_CLK_MCI_BUS/_CIU）
		 * resets: 0=MCI0（即 GK6323_RST_MCI0）
		 */
		emmc: mmc@f9830000 {
			compatible = "goke,gk6323v100c-dw-mshc", "snps,dw-mshc";
			reg = <0xf9830000 0x1000>, <0xf8a21000 0x40>;
			interrupts = <0 35 4>;
			clocks = <&cru 0>, <&cru 1>;
			clock-names = "biu", "ciu";
			resets = <&cru 0>;
			reset-names = "reset";
			fifo-depth = <0x100>;
			card-detect-delay = <200>;
			bus-width = <8>;
			non-removable;
			mmc-ddr-1_8v;
			disable-wp;
		};

		/*
		 * 百兆网口
		 * clocks: 7=BUS, 8=IF（FEMAC_BUS / FEMAC_IF）
		 * resets: 5=BUS, 6=MACIF（FEMAC_BUS / FEMAC_MACIF）
		 */
		femac: ethernet@f9c30000 {
			compatible = "hisilicon,hisi-femac-v2";
			reg = <0xf9c30000 0x1000>, <0xf9c31300 0x300>;
			interrupts = <0 72 4>;
			clocks = <&cru 7>, <&cru 8>;
			clock-names = "hisi_femac_clk", "clk_macif";
			resets = <&cru 5>, <&cru 6>;
			reset-names = "mac", "macif";
			phy-mode = "mii";
			phy-handle = <&phy2>;
		};

		mdio@f9c31100 {
			compatible = "hisilicon,hisi-femac-mdio";
			reg = <0xf9c31100 0x100>;
			clocks = <&cru 7>;
			#address-cells = <1>;
			#size-cells = <0>;

			phy2: ethernet-phy@2 {
				reg = <0x2>;
			};
		};

		/*
		 * USB2.0
		 * clocks: 2=BUS, 3=OHCI_48M, 4=HSTPHY, 5=UTMI0, 6=PHY_REF
		 * resets:
		 *   - EHCI: 1=HST, 2=UTMI0, 4=PORT0
		 *   - OHCI: 1=HST, 4=PORT0（OHCI 与 EHCI 共用 HST/端口复位）
		 * 复位顺序（驱动会处理 deassert）：HST→UTMI0→PHY_REF→PORT0
		 */
		ohci: usb@f9880000 {
			compatible = "generic-ohci";
			reg = <0xf9880000 0x10000>;
			interrupts = <0 67 4>;
			clocks = <&cru 2>, <&cru 3>;
			clock-names = "usb_host", "usb_ohci";
			resets = <&cru 1>, <&cru 4>;
			reset-names = "soft", "port";
		};

		ehci: usb@f9890000 {
			compatible = "generic-ehci";
			reg = <0xf9890000 0x10000>;
			interrupts = <0 66 4>;
			clocks = <&cru 2>, <&cru 4>, <&cru 5>, <&cru 6>;
			clock-names = "usb_host", "usb_hstphy", "usb_utmi0", "usb_phy_ref";
			resets = <&cru 1>, <&cru 2>, <&cru 4>;
			reset-names = "soft", "utmi0", "port";
		};

		/* SP805 看门狗 */
		watchdog@f8a2c000 {
			compatible = "arm,sp805-wdt", "arm,primecell";
			reg = <0xf8a2c000 0x1000>;
			clocks = <&clk_24m>;
			clock-names = "apb_pclk";
			clock-frequency = <24000000>;
			timeout-sec = <60>;
		};
	};
};
