// SPDX-License-Identifier: GPL-2.0+
/*
 * 国科微 GK6323V100C（整机型号 ChaoGe Z71A）板级设备树
 *
 * 本版关键改动（相对引导最小集）：
 *   1) 修正 soc 的 ranges 翻译（之前 4-cell 格式写错，导致 /soc 在 proc 下消失），
 *      外设统一写成 soc 内偏移地址，由 ranges 映射到 0xf0000000 物理段；
 *   2) 加入 Hi3798MV200 同源的 CRG 时钟复位控制器（f8a22000），主线驱动
 *      hisilicon,hi3798mv200-crg 会在 of_clk_init 阶段绑定；
 *   3) eMMC / FEMAC / MDIO / EHCI / OHCI / USB2-PHY 全部接上 CRG 的 clocks/resets，
 *      替换原来的 fixed-clock——fixed-clock 只能提供频率，打不开硬件门控和复位；
 *   4) 增加 usb2_phy1 节点（INNO USB2 PHY，f9865000），EHCI/OHCI 必须通过 phys
 *      属性引用 PHY 端口，否则 h/w reset 无法释放、必报 -110/-75；
 *   5) 网卡 compatible 改为主线认的 "hisilicon,hi3798mv200-femac","hisilicon,hisi-femac"，
 *      eMMC 改为 "hisilicon,hi3798mv200-dw-mshc" 让主线 dw_mmc 认领。
 *
 * 时钟/复位编号取自补丁库 410-01 的 dt-bindings/clock/hisilicon,hi3798mv200-crg.h
 * 与 915-02 的 hi3798mv200.dtsi，直接写成数字（GitHub Actions 里的 dtc 不跑
 * C 预处理器，无法处理 #include），数字值与宏一一对应，注释里保留宏名便于核对。
 *
 * 没加的（保持 dtb 体积，后续再补）：AIAO/ES8316 声卡、GPIO×8、uart2/3、i2c0/1、
 *   SDIO、IR、GPU。先把根文件系统依赖的 eMMC、远程调试用的网口、USB 三项点亮。
 *
 * 真机硬件事实保留：Cortex-A55 (part 0xd05) ×4、GICv3、PSCI-0.2、2GiB 内存、
 *   U-Boot 加载 DTB 上限 16KiB（作者版 dtb=9156 字节）。
 */

/dts-v1/;

/ {
	model = "ChaoGe Z71A (GK6323V100C) ARM64";
	compatible = "chaoge,z71a", "goke,gk6323v100c";
	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&gic>;

	aliases {
		serial0 = &uart0;
	};

	chosen {
		bootargs = "earlycon=pl011,mmio32,0xf8b00000,115200n8 console=ttyAMA0,115200n8 console=tty0 clk_ignore_unused net.ifnames=0 root=/dev/mmcblk0p18 rootfstype=ext4 rootwait rw panic=-1 blkdevparts=mmcblk0:1M(fastboot),512K(bootargs),512K(bootargsbak),20M(recovery),2M(deviceinfo),8M(securestore),2M(atf),8M(baseparam),8M(pqparam),2M(dtbo),10M(logo),10M(logobak),20M(fastplay),20M(recoverybak),60M(boot),20M(misc),20M(trustedcore),-(rootfs)";
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x80000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		bl31@8020000 {
			reg = <0x00 0x8020000 0x00 0x200000>;
			no-map;
		};

		optee@d200000 {
			reg = <0x00 0xd200000 0x00 0x400000>;
			no-map;
		};
	};

	/* 24MHz 晶振，给不经过 CRG 门控的辅助路径 */
	clk_24m: clk-24m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0>;
			enable-method = "psci";
			clocks = <&crg 10>; /* HI3798MV200_CPU_CLK */
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			enable-method = "psci";
			clocks = <&crg 10>;
		};

		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			enable-method = "psci";
			clocks = <&crg 10>;
		};

		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			enable-method = "psci";
			clocks = <&crg 10>;
		};
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <1 13 4>, <1 14 4>, <1 11 4>, <1 10 4>;
		clock-frequency = <24000000>;
	};

	gic: interrupt-controller@f1000000 {
		compatible = "arm,gic-v3";
		reg = <0x0 0xf1000000 0x0 0x10000>,
		      <0x0 0xf1040000 0x0 0x80000>;
		interrupt-controller;
		#interrupt-cells = <3>;
	};

	soc: soc@f0000000 {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		/* 子地址 1 cell → 父地址 2 cell + 大小 2 cell；0x0..0xfffffff 映射到 0xf0000000 */
		ranges = <0x0 0x0 0xf0000000 0x10000000>;

		/*
		 * Hi3798MV200 同源 CRG 时钟复位控制器（原厂 TTL: gk6323v100c-cru f8a22000.clock）
		 * compatible 双写 hisilicon,hi3798mv200-crg 让主线 CRG 驱动绑定；
		 * #clock-cells = <1> 用于 <&crg CLK_ID>；#reset-cells = <2> 用于 <&crg offset bit>。
		 */
		crg: clock-reset-controller@8a22000 {
			compatible = "hisilicon,hi3798mv200-crg", "syscon", "simple-mfd";
			reg = <0x8a22000 0x1000>;
			#clock-cells = <1>;
			#reset-cells = <2>;
		};

		uart0: serial@8b00000 {
			compatible = "arm,pl011", "arm,primecell";
			reg = <0x8b00000 0x1000>;
			interrupts = <0 49 4>;
			clocks = <&clk_24m>, <&crg 1>; /* uartclk, APB_CLK */
			clock-names = "uartclk", "apb_pclk";
		};

		i2c2: i2c@8b12000 {
			compatible = "hisilicon,hix5hd2-i2c";
			reg = <0x8b12000 0x1000>;
			interrupts = <0 40 4>;
			clocks = <&crg 27>; /* HI3798MV200_I2C2_CLK */
			clock-frequency = <100000>;
			#address-cells = <1>;
			#size-cells = <0>;

			rtc@51 {
				compatible = "nxp,pcf8563";
				reg = <0x51>;
			};
		};

		watchdog@8a2c000 {
			compatible = "arm,sp805", "arm,primecell";
			arm,primecell-periphid = <0x00141805>;
			reg = <0x8a2c000 0x1000>;
			interrupts = <0 29 4>;
			clocks = <&crg 132>, <&crg 1>; /* WDG0_CLK, APB_CLK */
			clock-names = "wdog_clk", "apb_pclk";
			resets = <&crg 0x178 4>; /* PERI_CRG94 bit 4 */
			timeout-sec = <60>;
		};

		/*
		 * eMMC（根文件系统）。clocks/resets 与主线 hi3798mv200.dtsi 的 emmc 节点一致：
		 *   CIU=48, BIU=47, SAMPLE=50, DRV=51；reset = PERI_CRG40(0xa0) bit 4
		 */
		emmc: mmc@9830000 {
			compatible = "hisilicon,hi3798mv200-dw-mshc";
			reg = <0x9830000 0x10000>;
			interrupts = <0 35 4>;
			clocks = <&crg 48>, <&crg 47>, <&crg 50>, <&crg 51>;
			clock-names = "ciu", "biu", "ciu-sample", "ciu-drive";
			resets = <&crg 0xa0 4>;
			reset-names = "reset";
			clk-phase-mmc-hs = <315 180>;
			clk-phase-mmc-hs200 = <90 90>;
			clk-phase-mmc-hs400 = <90 90>;
			clk-phase-mmc-ddr52 = <90 90>;
			hisilicon,sap-dll-reg = <&crg 0x39c>;
			fifo-depth = <0x100>;
			card-detect-delay = <200>;
			bus-width = <8>;
			non-removable;
			mmc-ddr-1_8v;
			disable-wp;
		};

		/*
		 * INNO USB2 PHY（覆盖两个主机端口），基址 0x9865000，与主线 hi3798mv200.dtsi
		 * 中 usb2_phy1 一致；port0→OHCI，port1→EHCI。
		 *   ref clock = USB2_PHY1_REF_CLK(71); reset = 0xbc bit 4;
		 *   port0 reset = 0xbc bit 8; port1 reset = 0xbc bit 9
		 */
		usb2_phy1: usb-phy@9865000 {
			compatible = "hisilicon,hi3798mv200-usb2-phy";
			reg = <0x9865000 0x800>;
			clocks = <&crg 71>;
			resets = <&crg 0xbc 4>;
			#address-cells = <1>;
			#size-cells = <0>;

			usb2_phy1_port0: phy@0 {
				reg = <0>;
				resets = <&crg 0xbc 8>;
				#phy-cells = <0>;
			};

			usb2_phy1_port1: phy@1 {
				reg = <1>;
				resets = <&crg 0xbc 9>;
				#phy-cells = <0>;
			};
		};

		/*
		 * OHCI：BUS_CLK=63, 12M_CLK=65, 48M_CLK=64；reset=0xb8 bit 12；挂 port0
		 */
		ohci: usb@9880000 {
			compatible = "generic-ohci";
			reg = <0x9880000 0x10000>;
			interrupts = <0 67 4>;
			clocks = <&crg 63>, <&crg 65>, <&crg 64>;
			resets = <&crg 0xb8 12>;
			phys = <&usb2_phy1_port0>;
		};

		/*
		 * EHCI：BUS_CLK=63, HST_PHY_CLK=67, UTMI0=68, UTMI1=69；
		 * resets = 0xb8 bit 12(软)/13/14/16；挂 port1
		 */
		ehci: usb@9890000 {
			compatible = "generic-ehci";
			reg = <0x9890000 0x10000>;
			interrupts = <0 66 4>;
			clocks = <&crg 63>, <&crg 67>, <&crg 68>, <&crg 69>;
			resets = <&crg 0xb8 12>, <&crg 0xb8 16>, <&crg 0xb8 13>, <&crg 0xb8 14>;
			phys = <&usb2_phy1_port1>;
		};

		/*
		 * FEMAC 百兆网口：ETH_CLK=84, ETH_BUS_CLK=83, FEPHY_CLK=178；
		 * mac reset = PERI_CRG52(0xd0) bit 3；phy reset = PERI_CRG226(0x388) bit 4。
		 * PHY 地址按真机是 2（原厂 TTL: "Generic PHY (2)"）。
		 */
		femac: ethernet@9c30000 {
			compatible = "hisilicon,hi3798mv200-femac", "hisilicon,hisi-femac";
			reg = <0x9c30000 0x1000>, <0x9c31300 0x200>;
			interrupts = <0 72 4>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x0 0x9c30000 0x10000>;
			clocks = <&crg 84>, <&crg 83>, <&crg 178>;
			clock-names = "mac", "macif", "phy";
			resets = <&crg 0xd0 3>, <&crg 0x388 4>;
			reset-names = "mac", "phy";
			phy-handle = <&fephy>;
			phy-mode = "mii";
			phy-connection-type = "mii";
			hisilicon,phy-reset-delays-us = <10000 10000 500000>;

			mdio: mdio@1100 {
				compatible = "hisilicon,hisi-femac-mdio";
				reg = <0x1100 0x20>;
				#address-cells = <1>;
				#size-cells = <0>;

				fephy: ethernet-phy@2 {
					reg = <2>;
					#phy-cells = <0>;
				};
			};
		};
	};
};
