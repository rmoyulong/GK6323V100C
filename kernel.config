#
# 国科微 GK6323V100C（ChaoGe Z71A）主线内核配置
# 基线：Linux 7.4-rc2，Cortex-A55 + GICv3 + ARM64
# 目标：串口、eMMC(ext4)、网口、USB、USB音频全部可用
#

# ===== 平台与 CPU =====
CONFIG_ARM64=y
CONFIG_ARCH_HISI=y
CONFIG_ARCH_MULTI_V7 is not set
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_39=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_PM=y

# Cortex-A55 勘误
CONFIG_ARM64_ERRATUM_826319=y
CONFIG_ARM64_ERRATUM_827319=y
CONFIG_ARM64_ERRATUM_824069=y
CONFIG_ARM64_ERRATUM_819472=y
CONFIG_ARM64_ERRATUM_832075=y
CONFIG_ARM64_ERRATUM_1024718=y
CONFIG_ARM64_ERRATUM_1286807=y
CONFIG_ARM64_ERRATUM_1418040=y
CONFIG_ARM64_ERRATUM_1542419=y
CONFIG_ARM64_ERRATUM_2441007=y

# PSCI
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_PSCI_CHECKER=y
CONFIG_HAVE_ARM_SMCCC=y

# GICv3
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V2M is not set
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_GIC_V3_ITS is not set

# 定时器
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_ARCH_TIMER_EVTSTREAM=y
CONFIG_CLKSRC_OF=y
CONFIG_CLKEVT_ARM_GLOBAL_TIMER is not set

# ===== 串口控制台 =====
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_ARM_SEMIHOST is not set
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_HVC_DRIVER=y

# ===== 命令行（不写死 root=，由 bootargs 下发） =====
CONFIG_CMDLINE=""
CONFIG_CMDLINE_FROM_BOOTLOADER=y
CONFIG_CMDLINE_EXTEND is not set
CONFIG_CMDLINE_FORCE is not set

# ===== 内存与分区 =====
CONFIG_ZONE_DMA32=y
CONFIG_MEMORY_ISOLATION is not set
CONFIG_CMA_SIZE_MBYTES=16
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_EARLY_FLATTREE=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y
CONFIG_OF_RESERVED_MEM=y

# blkdevparts（本机 bootargs 用它下发分区表）
CONFIG_PARTITION_ADVANCED=y
CONFIG_CMDLINE_PARTITION=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM is not set

# ===== eMMC (Synopsys DesignWare MMC) =====
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_HI3798CV200=y
CONFIG_MMC_SDHCI is not set

# ===== 文件系统 =====
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_JBD2=y
CONFIG_FS_MBCACHE=y
CONFIG_VFAT_FS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_UTF8=y
CONFIG_FUSE_FS=m
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# ===== USB 主机 =====
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_HUB_USB251XB is not set
CONFIG_USB_STORAGE=y
CONFIG_USB_USBNET=m
CONFIG_USB_NET_DRIVERS=m

# USB PHY (HiSilicon INNO USB2)
CONFIG_PHY_HISI_INNO_USB2=y
CONFIG_GENERIC_PHY=y
CONFIG_NOP_USB_XCEIV=y

# ===== 以太网（HISI FEMAC） =====
CONFIG_NET=y
CONFIG_NET_VENDOR_HISILICON=y
CONFIG_HISI_FEMAC=y
CONFIG_HISI_FEMAC_RMII=y
CONFIG_PHYLIB=y
CONFIG_FIXED_PHY=y
CONFIG_OF_MDIO=y
CONFIG_MDIO_BUS=y
CONFIG_MDIO_DEVRES=y
CONFIG_MICREL_PHY=y
CONFIG_REALTEK_PHY=y

# ===== 模块支持 =====
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SRCVERSION_ALL=y

# ===== ALSA + USB 音频（本仓库核心目标） =====
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y
CONFIG_SND_HWDEP=m
CONFIG_SND_RAWMIDI=m
CONFIG_SND_JACK=y
CONFIG_SND_SEQUENCER=m
CONFIG_SND_SEQ_DUMMY=m
CONFIG_SND_OSSEMUL=y
CONFIG_SND_MIXER_OSS=m
CONFIG_SND_PCM_OSS=m
CONFIG_SND_SOC=y
CONFIG_SND_SOC_HISTB=m
CONFIG_SND_SOC_ES8316=m
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_USB_AUDIO_USE_MEDIA_CONTROLLER=y
CONFIG_USB_ACM=m

# ===== RTC =====
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_HI655X is not set
CONFIG_RTC_DRV_HISI=y
CONFIG_RTC_DRV_PL031=y

# ===== 看门狗 =====
CONFIG_WATCHDOG=y
CONFIG_ARM_SP805_WATCHDOG=y

# GPIO (PL061)
CONFIG_GPIOLIB=y
CONFIG_GPIO_PL061=y

# I2C
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y

# DMA
CONFIG_DMADEVICES=y
CONFIG_AMBA_PL08X=y

# Regulator
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# Reset controller
CONFIG_RESET_CONTROLLER=y
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_HI3620=y
CONFIG_COMMON_CLK_HI6220 is not set

# Pin control
CONFIG_PINCTRL=y
CONFIG_PINCTRL_HISI=y

# ===== 其他必要项 =====
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_LOG_BUF_SHIFT=17
CONFIG_PRINTK_TIME=y
CONFIG_PRINTK_CALLER is not set
CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_KEXEC_FILE is not set
CONFIG_RANDOMIZE_BASE=y
CONFIG_CC_STACKPROTECTOR_STRONG=y
CONFIG_SLUB_DEBUG is not set

# 网络基础
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NET_KEY=m
CONFIG_NETLINK_DIAG=m
CONFIG_INET_DIAG=m
CONFIG_INET_UDP_DIAG=m
CONFIG_INET_TCP_DIAG=m
CONFIG_TUN=m
CONFIG_VETH=m
CONFIG_BRIDGE=m

# Crypto
CONFIG_CRYPTO_USER=y
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
CONFIG_CRYPTO_USER_API_AEAD=m
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y

# 解压支持
CONFIG_DECOMPRESS_GZIP=y
CONFIG_DECOMPRESS_BZIP2 is not set
CONFIG_DECOMPRESS_LZMA is not set
CONFIG_DECOMPRESS_XZ=y
CONFIG_DECOMPRESS_LZO is not set
CONFIG_DECOMPRESS_LZ4=y
CONFIG_DECOMPRESS_ZSTD=y

# 禁用无关项以减小体积
CONFIG_DRM is not set
CONFIG_FB is not set
CONFIG_INPUT_KEYBOARD is not set
CONFIG_INPUT_MOUSE is not set
CONFIG_SOUND_PRIME is not set
CONFIG_WIRELESS is not set
CONFIG_RFKILL is not set
CONFIG_BT is not set
CONFIG_CFG80211 is not set
CONFIG_MAC80211 is not set
CONFIG_VIDEO_DEV is not set
CONFIG_MEDIA_SUPPORT is not set
CONFIG_MTD is not set
CONFIG_UBIFS_FS is not set
CONFIG_JFFS2_FS is not set
CONFIG_SQUASHFS is not set
CONFIG_NFS_FS is not set
CONFIG_CIFS is not set
CONFIG_BTRFS_FS is not set
CONFIG_XFS_FS is not set
CONFIG_F2FS_FS is not set
CONFIG_KVM is not set
CONFIG_VHOST_NET is not set
CONFIG_BPF is not set
